                }}
            }
            pcall(function()
                requestFunc({
                    Url = webhookUrl,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(data)
                })
            end)
            SendFeedbackBtn.Text = "Sent Successfully!"
            FeedbackBox.Text = ""
            task.delay(2, function()
                SendFeedbackBtn.Text = "Send Feedback"
            end)
        else
            SendFeedbackBtn.Text = "Executor not supported!"
            task.delay(2, function()
                SendFeedbackBtn.Text = "Send Feedback"
            end)
        end
    else
        SendFeedbackBtn.Text = "Please enter text!"
        task.delay(2, function()
            SendFeedbackBtn.Text = "Send Feedback"
        end)
    end
end)

