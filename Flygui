MinimizeBtn.Position = UDim2.new(1, -60, 0, 5)
MinimizeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
MinimizeBtn.TextColor3 = Color3.new(1, 1, 1)
MinimizeBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", MinimizeBtn)

-- KÜÇÜLMÜŞ YUVARLAK SİMGE
local OpenBtn = Instance.new("TextButton", ScreenGui)
OpenBtn.Text = "L"
OpenBtn.Size = UDim2.new(0, 45, 0, 45)
OpenBtn.Position = UDim2.new(0, 10, 0.5, -22)
OpenBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
OpenBtn.TextColor3 = Color3.new(0, 0, 0)
OpenBtn.Font = Enum.Font.GothamBold
OpenBtn.Visible = false
Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1, 0)
Instance.new("UIStroke", OpenBtn).Thickness = 2

-- Buton Fonksiyonları
CloseBtn.MouseButton1Click:Connect(function() 
    flying = false 
    ScreenGui:Destroy() 
end)

MinimizeBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    OpenBtn.Visible = true
end)

OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    OpenBtn.Visible = false
end)

-- [ FLY BUTONU ] --
local FlyBtn = Instance.new("TextButton", MainFrame)
FlyBtn.Text = "FLY: OFF"
FlyBtn.Size = UDim2.new(0, 160, 0, 40)
FlyBtn.Position = UDim2.new(0.5, -80, 0.5, -5)
FlyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
